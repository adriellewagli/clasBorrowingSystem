<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="root-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.LoginController">
    <children>
        <!-- Left Hero Banner (Brand / Announcement Panel) -->
        <VBox alignment="CENTER_LEFT" spacing="15.0" styleClass="hero-banner" prefWidth="420.0" minWidth="420.0" maxWidth="420.0">
            <padding>
                <Insets bottom="60.0" left="55.0" right="55.0" top="60.0" />
            </padding>
            <children>
                <Label styleClass="hero-title" text="CLAS Borrowing&#10;System" wrapText="true" />
                <Label styleClass="hero-subtitle" text="Seamless equipment tracking, borrowing, and inventory management for your organization." wrapText="true" />
            </children>
        </VBox>

        <!-- Right Panel (Centered Pastel Login Form) -->
        <VBox alignment="CENTER" styleClass="login-side-panel" HBox.hgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="login-card">
                    <children>
                        <VBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Label styleClass="title-text" text="Welcome Back" />
                                <Label styleClass="subtitle-text" text="Enter your credentials to access your account" />
                            </children>
                        </VBox>

                        <VBox spacing="14.0">
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Username" />
                                        <TextField fx:id="txtUsername" onAction="#focusPassword" promptText="Enter your username" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Password" />
                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="Enter your password" styleClass="password-input" />
                                                <TextField fx:id="txtPasswordShown" managed="false" onAction="#handleLogin" promptText="Enter your password" styleClass="password-input" visible="false" />
                                                <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility" styleClass="icon-button" text="Show" StackPane.alignment="CENTER_RIGHT">
                                                    <StackPane.margin>
                                                        <Insets right="12.0" />
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Hyperlink onAction="#handleForgotPassword" styleClass="hyperlink-pastel" text="Forgot password?" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" onAction="#handleLogin" styleClass="button-primary" text="Sign In" />
                                <Label fx:id="lblMessage" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
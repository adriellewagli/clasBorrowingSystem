<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15 20 15 20;" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblWelcome" text="Welcome to CLAS Equipment Borrowing System" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnLogout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Logout" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Available Equipment Overview">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TableView fx:id="tblEquipment" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="200.0" text="Item Name" />
                        <TableColumn fx:id="colCategory" prefWidth="150.0" text="Category" />
                        <TableColumn fx:id="colSerial" prefWidth="150.0" text="Serial Number" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 20 20 20;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnBorrow" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Borrow Item" />
                <Button fx:id="btnReturn" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Return Item" />
                <Button fx:id="btnManage" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Manage Inventory" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../../css/dashboard.css"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.user.UserDashboardController">

    <fx:define>
        <ToggleGroup fx:id="profileTypeGroup"/>
    </fx:define>

    <!-- MAIN DASHBOARD CONTENT -->
    <BorderPane fx:id="mainContentPane">
        <top>
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="logo-badge">
                        <Label text="CL" styleClass="logo-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="CLAS Borrowing System" styleClass="header-title"/>
                        <Label text="Equipment Portal" styleClass="header-subtitle"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8">
                    <Label text="System Status:" styleClass="top-console-label"/>
                    <Label text="• Operational" styleClass="status-pill-green"/>
                </HBox>
            </HBox>
        </top>

        <left>
            <VBox styleClass="sidebar" prefWidth="220" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="user-avatar-circle">
                        <Label fx:id="lblUserAvatar" text="US" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="lblUserName" text="User Name" styleClass="user-profile-name"/>
                        <Label fx:id="lblUserRole" text="STUDENT" styleClass="role-badge"/>
                    </VBox>
                </HBox>

                <Separator styleClass="sidebar-divider"/>

                <Button fx:id="btnNavCatalog" text="Equipment Catalog" styleClass="sidebar-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewCatalog"/>
                <Button fx:id="btnNavMyBorrows" text="My Active Borrows" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewMyBorrows"/>
                <Button fx:id="btnNavRequestLog" text="Borrow Request" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewBorrowRequest"/>
                <Button fx:id="btnNavSettings" text="Account Settings" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewSettings"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Log Out" styleClass="sidebar-btn-logout" maxWidth="Infinity" alignment="CENTER" onAction="#handleLogout"/>
            </VBox>
        </left>

        <center>
            <StackPane fx:id="dynamicContentArea">
                <VBox fx:id="catalogViewContainer" spacing="16">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- METRIC OVERVIEW CARDS -->
                    <HBox spacing="16">
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Catalog Units" styleClass="metric-title"/>
                            <Label fx:id="lblTotalUnits" text="0" styleClass="metric-value-dark"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Available to Borrow" styleClass="metric-title"/>
                            <Label fx:id="lblAvailableUnits" text="0" styleClass="metric-value-green"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Currently Checked Out" styleClass="metric-title"/>
                            <Label fx:id="lblCheckedOutUnits" text="0" styleClass="metric-value-blue"/>
                        </VBox>
                    </HBox>

                    <!-- SEARCH & FILTER ROW WITH MANUAL REFRESH BUTTON -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <TextField fx:id="txtSearch" promptText="Search equipment name, serial, or category..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button fx:id="btnFilterAll" text="All Gear" styleClass="filter-chip-active" onAction="#filterAll"/>
                            <Button fx:id="btnFilterAvailable" text="Available Only" styleClass="filter-chip" onAction="#filterAvailable"/>
                            <Button fx:id="btnFilterMaintenance" text="In Maintenance" styleClass="filter-chip" onAction="#filterRepair"/>
                            <Button fx:id="btnRefreshData" text="🔄 Refresh Data" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 6 14;" onAction="#handleManualRefresh"/>
                        </HBox>
                    </HBox>

                    <!-- MAIN TABLE CARD WITH CONSTRAINED RESIZE POLICY -->
                    <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="tblEquipment" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName" text="EQUIPMENT ITEM" prefWidth="240"/>
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="180"/>
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
                                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                                <TableColumn fx:id="colAction" text="ACTION" prefWidth="130" resizable="false"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
                            <Label text="Tip: Click '+ Select' to queue gear or '✕ Unselect' to remove it. Auto-syncs with LAN server every 5s." styleClass="footer-caption"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

    <!-- BORROW REQUEST MODAL OVERLAY -->
    <StackPane fx:id="modalOverlay" visible="false" styleClass="modal-backdrop" StackPane.alignment="CENTER">
        <VBox fx:id="modalDialogBox" styleClass="modal-dialog" maxWidth="640" spacing="16" StackPane.alignment="CENTER">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Equipment Borrowing Checkout" styleClass="modal-title"/>
                    <Label fx:id="lblModalAssetName" text="Asset Name" styleClass="modal-asset-name"/>
                    <Label fx:id="lblModalAssetDept" text="Category" styleClass="modal-asset-dept"/>
                </VBox>
                <Button text="✕" styleClass="modal-close-btn" onAction="#closeModal"/>
            </HBox>

            <Separator styleClass="sidebar-divider"/>

            <VBox spacing="14">
                <VBox spacing="6">
                    <Label text="Borrower Profile Type:" styleClass="modal-label"/>
                    <HBox spacing="20">
                        <RadioButton fx:id="radioStudent" text="Student" toggleGroup="$profileTypeGroup" selected="true" onAction="#handleProfileTypeChange"/>
                        <RadioButton fx:id="radioFaculty" text="Faculty" toggleGroup="$profileTypeGroup" onAction="#handleProfileTypeChange"/>
                    </HBox>
                </VBox>

                <VBox spacing="8">
                    <VBox spacing="4">
                        <Label text="Full Name:" styleClass="modal-label"/>
                        <TextField fx:id="txtBorrowerName" promptText="e.g. Juan Cruz"/>
                    </VBox>

                    <VBox fx:id="boxStudentFields" spacing="8">
                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Student ID Number:" styleClass="modal-label"/>
                                <TextField fx:id="txtStudentId" promptText="e.g. 20250045-N"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Program / Course:" styleClass="modal-label"/>
                                <ComboBox fx:id="txtCourse" promptText="Select your academic program" maxWidth="Infinity" prefHeight="38"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxFacultyFields" spacing="8" visible="false" managed="false">
                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Employee ID Number:" styleClass="modal-label"/>
                                <TextField fx:id="txtEmployeeId" promptText="e.g. EMP-2021-08"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Department:" styleClass="modal-label"/>
                                <ComboBox fx:id="txtDepartment" promptText="Select your department" maxWidth="Infinity" prefHeight="38"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="6">
                    <Label text="ID Verification / Camera Capture:" styleClass="modal-label"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <StackPane fx:id="cameraPreviewBox" style="-fx-background-color: #1f2937; -fx-background-radius: 8px;" prefWidth="160" prefHeight="100">
                            <ImageView fx:id="imgCameraPreview" fitWidth="160" fitHeight="100" preserveRatio="true"/>
                            <Label fx:id="lblCameraStatus" text="📷 Click to Capture ID Snapshot" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                        </StackPane>
                        <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <HBox spacing="8">
                                <Button fx:id="btnCaptureId" text="📷 Capture ID / Take Snap" styleClass="btn-secondary" onAction="#handleCaptureIdSnap"/>
                                <Button fx:id="btnRetakeSnap" text="🔄 Retake" styleClass="btn-secondary" onAction="#handleRetakeSnap" visible="false" managed="false"/>
                            </HBox>
                            <Label text="Required for physical pickup verification." wrapText="true" styleClass="footer-caption"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="8">
                    <Label text="Select Planned Return Target Date:" styleClass="modal-label"/>
                    <HBox spacing="8">
                        <Button fx:id="btn3Days" text="3 Days" styleClass="filter-chip-active" onAction="#select3Days"/>
                        <Button fx:id="btn7Days" text="7 Days" styleClass="filter-chip" onAction="#select7Days"/>
                        <Button fx:id="btnCustomDate" text="Custom" styleClass="filter-chip" onAction="#selectCustomDate"/>
                    </HBox>
                    <DatePicker fx:id="dpReturnTarget" maxWidth="Infinity" styleClass="modal-datepicker" onAction="#calculateTransactionFees"/>
                </VBox>

                <VBox style="-fx-background-color: #f3f4f6; -fx-padding: 12px; -fx-background-radius: 8px;" spacing="4">
                    <HBox>
                        <Label text="Borrow Start Timestamp:" styleClass="footer-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblBorrowTimestamp" text="Now" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox>
                        <Label text="Base Daily Rate:" styleClass="footer-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="₱20.00 / day"/>
                    </HBox>
                    <HBox>
                        <Label text="Calculated Base Fee:" styleClass="footer-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCalculatedFee" text="₱60.00 (3 days)" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    </HBox>
                    <HBox>
                        <Label text="Late Return Penalty Rate:" styleClass="footer-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="₱50.00 / day overdue" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <CheckBox fx:id="chkCompliance"
                          text="I agree to return the equipment on or before the due date and assume responsibility for physical care."
                          wrapText="true"
                          styleClass="modal-checkbox"/>

                <Label fx:id="lblModalError" styleClass="modal-error-label" wrapText="true"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#closeModal"/>
                <Button text="Confirm Borrow Request" styleClass="btn-primary" onAction="#confirmBorrowCommit"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import util.IdSnapshotPane?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.user.BorrowEquipmentController">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Borrow Equipment" styleClass="page-title"/>
            <Label text="Add the equipment to the queue, set each item's return date and price, then fill in the borrower's details. Use Reserve to hold an item for a later date."
                   styleClass="page-subtitle" wrapText="true"/>
        </VBox>
        <Button fx:id="btnRefreshData" text="🔄 Refresh Data" styleClass="btn-secondary" onAction="#handleManualRefresh"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- LEFT: EQUIPMENT + QUEUE -->
        <VBox spacing="16" HBox.hgrow="ALWAYS">

            <!-- Available equipment -->
            <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS" prefHeight="240" minHeight="200">
                <HBox styleClass="card-title-bar" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Equipment" styleClass="section-title"/>
                    <Label fx:id="lblUnitSummary" text="" styleClass="field-hint-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnFilterAll" text="All" styleClass="filter-chip-active" onAction="#filterAll"/>
                    <Button fx:id="btnFilterAvailable" text="Available" styleClass="filter-chip" onAction="#filterAvailable"/>
                    <Button fx:id="btnFilterMaintenance" text="In Maintenance" styleClass="filter-chip" onAction="#filterRepair"/>
                </HBox>
                <TextField fx:id="txtSearch" promptText="Search equipment name, category, or serial number..." styleClass="clean-search-field"/>
                <TableView fx:id="tblEquipment" VBox.vgrow="ALWAYS" minHeight="120">
                    <placeholder>
                        <Label text="No equipment items found" styleClass="empty-state"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colName" text="EQUIPMENT" prefWidth="210"/>
                        <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="140"/>
                        <TableColumn fx:id="colStatus" text="STATUS" prefWidth="130"/>
                        <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="130"/>
                        <TableColumn fx:id="colAction" text="ACTION" prefWidth="210" sortable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Selected queue -->
            <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="320">
                <HBox styleClass="card-title-bar" alignment="CENTER_LEFT">
                    <Label text="Selected Equipment Queue" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnClearCart" text="Clear Queue" styleClass="btn-danger-soft" onAction="#handleClearCart"/>
                </HBox>

                <TableView fx:id="tblCart" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Nothing selected yet. Click + Add on an available item above." styleClass="empty-state"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colCartName" text="EQUIPMENT" prefWidth="200"/>
                        <TableColumn fx:id="colCartReturn" text="RETURN DATE" prefWidth="170" sortable="false"/>
                        <TableColumn fx:id="colCartPrice" text="PRICE (₱)" prefWidth="130" sortable="false"/>
                        <TableColumn fx:id="colCartAction" text="" prefWidth="100" resizable="false" sortable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <VBox styleClass="fee-box">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Queue item count" styleClass="fee-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblQueueCount" text="0 Items" styleClass="fee-value"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total of item prices" styleClass="fee-value"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCalculatedFee" text="₱0.00" styleClass="fee-value"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Late return penalty" styleClass="fee-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblLatePenalty" text="—" styleClass="fee-label"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>

        <!-- RIGHT: BORROWER + VERIFICATION -->
        <ScrollPane fitToWidth="true" prefWidth="400" minWidth="400" styleClass="transparent-scroll" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16" styleClass="main-dashboard-card">
                    <padding>
                        <Insets top="22" right="22" bottom="22" left="22"/>
                    </padding>

                    <Label text="Borrower Details" styleClass="section-title"/>

                    <HBox spacing="18">
                        <RadioButton fx:id="radioStudent" text="Student" selected="true" onAction="#handleProfileTypeChange">
                            <toggleGroup><ToggleGroup fx:id="profileTypeGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radioFaculty" text="Faculty" toggleGroup="$profileTypeGroup" onAction="#handleProfileTypeChange"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Full Borrower Name" styleClass="modal-label"/>
                        <TextField fx:id="txtBorrowerName" promptText="e.g. Juan Dela Cruz" styleClass="clean-search-field"/>
                    </VBox>

                    <VBox fx:id="boxStudentFields" spacing="12">
                        <VBox spacing="6">
                            <Label text="Student Number" styleClass="modal-label"/>
                            <TextField fx:id="txtStudentId" promptText="Format: 20250045-N" styleClass="clean-search-field"/>
                            <Label fx:id="lblStudentIdError" wrapText="true"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Academic Program" styleClass="modal-label"/>
                            <ComboBox fx:id="txtCourse" maxWidth="Infinity" promptText="Select academic program" prefHeight="40"/>
                        </VBox>
                    </VBox>

                    <VBox fx:id="boxFacultyFields" spacing="12" managed="false" visible="false">
                        <VBox spacing="6">
                            <Label text="Employee ID" styleClass="modal-label"/>
                            <TextField fx:id="txtEmployeeId" promptText="e.g. EMP-1002" styleClass="clean-search-field"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Department" styleClass="modal-label"/>
                            <ComboBox fx:id="txtDepartment" maxWidth="Infinity" promptText="Select department" prefHeight="40"/>
                        </VBox>
                    </VBox>

                    <Separator styleClass="sidebar-divider"/>

                    <VBox spacing="8">
                        <Label text="Return Schedule" styleClass="modal-label"/>
                        <Label text="Each item has its own return date and price in the queue. Use these buttons to give every item the same deadline, then adjust any item you need."
                               styleClass="field-hint-text" wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Set all to:" styleClass="fee-label"/>
                            <Button text="1 Day" styleClass="filter-chip" onAction="#select1Day"/>
                            <Button text="3 Days" styleClass="filter-chip" onAction="#select3Days"/>
                            <Button text="7 Days" styleClass="filter-chip" onAction="#select7Days"/>
                        </HBox>
                    </VBox>

                    <Separator styleClass="sidebar-divider"/>

                    <VBox spacing="8">
                        <Label text="ID Verification" styleClass="modal-label"/>
                        <IdSnapshotPane fx:id="snapshot"/>
                    </VBox>

                    <CheckBox fx:id="chkCompliance" text="I confirm the equipment will be returned on time and in good condition." wrapText="true" styleClass="modal-checkbox"/>
                    <Label fx:id="lblErrorMsg" styleClass="form-message-error" wrapText="true" maxWidth="Infinity"/>

                    <Button fx:id="btnSubmitRequest" text="Submit Borrow Request" styleClass="btn-success" maxWidth="Infinity" prefHeight="44" onAction="#handleConfirmCommit"/>
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</VBox>

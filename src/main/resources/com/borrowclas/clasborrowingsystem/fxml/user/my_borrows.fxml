<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="root-canvas" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.user.MyBorrowsController" stylesheets="@../../css/dashboard.css">

    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <!-- HEADER & ACTION BAR -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <Label text="My Active Borrows" styleClass="modal-title"/>
            <Label text="Monitor checked-out assets, return deadlines, and pending penalties." styleClass="header-subtitle"/>
        </VBox>
        <Button text="🔄 Refresh List" onAction="#handleRefresh" styleClass="btn-secondary"/>
    </HBox>

    <!-- METRIC CARDS ROW -->
    <HBox spacing="16">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Active Loans" styleClass="metric-title"/>
            <Label fx:id="lblActiveLoansCount" text="0" styleClass="metric-value-blue"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Overdue Items" styleClass="metric-title"/>
            <Label fx:id="lblOverdueCount" text="0" styleClass="metric-value-dark"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Accrued Late Fees" styleClass="metric-title"/>
            <Label fx:id="lblTotalLateFees" text="₱0.00" styleClass="metric-value-dark"/>
        </VBox>
    </HBox>

    <!-- MAIN TABLE CONTAINER CARD -->
    <VBox VBox.vgrow="ALWAYS" styleClass="main-dashboard-card">
        <TableView fx:id="tblActiveBorrows" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colBorrowId" text="Borrow ID" prefWidth="90"/>
                <TableColumn fx:id="colEquipmentName" text="Equipment" prefWidth="200"/>
                <TableColumn fx:id="colSerialNumber" text="Serial Number" prefWidth="130"/>
                <TableColumn fx:id="colBorrowDate" text="Borrowed Date" prefWidth="120"/>
                <TableColumn fx:id="colDueDate" text="Due Date" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="130"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- TABLE FOOTER BAR -->
        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
            <Label text="Showing active loans assigned to your account." styleClass="footer-caption"/>
        </HBox>
    </VBox>
</VBox>
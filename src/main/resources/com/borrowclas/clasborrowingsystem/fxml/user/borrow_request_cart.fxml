<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.user.BorrowRequestCartController">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Borrow Request Checkout" styleClass="page-title"/>
            <Label text="Review your selected equipment and complete verification details." styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="btnClearCart" text="Clear Request Queue" styleClass="btn-danger-soft" onAction="#handleClearCart"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- LEFT: QUEUE -->
        <VBox fx:id="tableCard" styleClass="main-dashboard-card" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-title-bar" alignment="CENTER_LEFT">
                <Label text="Selected Equipment Queue" styleClass="section-title"/>
            </HBox>

            <TableView fx:id="tblCart" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCartName" text="EQUIPMENT" prefWidth="220"/>
                    <TableColumn fx:id="colCartCategory" text="CATEGORY" prefWidth="150"/>
                    <TableColumn fx:id="colCartSerial" text="SERIAL NUMBER" prefWidth="140"/>
                    <TableColumn fx:id="colCartAction" text="" prefWidth="100" resizable="false" sortable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <VBox styleClass="fee-box">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Queue item count" styleClass="fee-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblQueueCount" text="0 Items" styleClass="fee-value"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total calculated fee" styleClass="fee-value"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCalculatedFee" text="₱0.00" styleClass="fee-total"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- RIGHT: BORROWER + VERIFICATION -->
        <ScrollPane fitToWidth="true" prefWidth="450" minWidth="450" styleClass="transparent-scroll" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16" styleClass="main-dashboard-card">
                    <padding>
                        <Insets top="22" right="22" bottom="22" left="22"/>
                    </padding>

                    <Label text="Borrower Profile &amp; Duration" styleClass="section-title"/>

                    <HBox spacing="18">
                        <RadioButton fx:id="radioStudent" text="Student" selected="true" onAction="#handleProfileTypeChange">
                            <toggleGroup><ToggleGroup fx:id="profileTypeGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radioFaculty" text="Faculty" toggleGroup="$profileTypeGroup" onAction="#handleProfileTypeChange"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Full Borrower Name" styleClass="modal-label"/>
                        <TextField fx:id="txtBorrowerName" promptText="e.g. Juan Dela Cruz" styleClass="clean-search-field"/>
                    </VBox>

                    <VBox fx:id="boxStudentFields" spacing="12">
                        <VBox spacing="6">
                            <Label text="Student Number" styleClass="modal-label"/>
                            <TextField fx:id="txtStudentId" promptText="Format: 20250045-N" styleClass="clean-search-field"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Academic Program" styleClass="modal-label"/>
                            <ComboBox fx:id="txtCourse" maxWidth="Infinity" promptText="Select academic program" prefHeight="40"/>
                        </VBox>
                    </VBox>

                    <VBox fx:id="boxFacultyFields" spacing="12" managed="false" visible="false">
                        <VBox spacing="6">
                            <Label text="Employee ID" styleClass="modal-label"/>
                            <TextField fx:id="txtEmployeeId" promptText="e.g. EMP-1002" styleClass="clean-search-field"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Department" styleClass="modal-label"/>
                            <ComboBox fx:id="txtDepartment" maxWidth="Infinity" promptText="Select department" prefHeight="40"/>
                        </VBox>
                    </VBox>

                    <Separator styleClass="sidebar-divider"/>

                    <VBox spacing="8">
                        <Label text="Return Schedule" styleClass="modal-label"/>
                        <HBox spacing="8">
                            <Button fx:id="btn1Day" text="1 Day" styleClass="filter-chip" onAction="#select1Day"/>
                            <Button fx:id="btn3Days" text="3 Days" styleClass="filter-chip-active" onAction="#select3Days"/>
                            <Button fx:id="btn7Days" text="7 Days" styleClass="filter-chip" onAction="#select7Days"/>
                            <Button fx:id="btnCustomDate" text="Custom" styleClass="filter-chip" onAction="#selectCustomDate"/>
                        </HBox>
                        <DatePicker fx:id="dpReturnTarget" maxWidth="Infinity" onAction="#calculateTransactionFees"/>
                    </VBox>

                    <Separator styleClass="sidebar-divider"/>

                    <VBox spacing="8">
                        <Label text="ID Verification" styleClass="modal-label"/>
                        <StackPane fx:id="cameraPreviewBox" styleClass="camera-box" prefHeight="170">
                            <ImageView fx:id="imgCameraPreview" fitHeight="160" fitWidth="230" preserveRatio="true"/>
                            <Label fx:id="lblCameraStatus" text="Click capture to start camera preview" styleClass="camera-hint"/>
                        </StackPane>
                        <HBox spacing="8">
                            <Button fx:id="btnCaptureId" text="Start Camera" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleCaptureIdSnap"/>
                            <Button fx:id="btnRetakeSnap" text="Retake" styleClass="btn-secondary" managed="false" visible="false" onAction="#handleRetakeSnap"/>
                        </HBox>
                    </VBox>

                    <CheckBox fx:id="chkCompliance" text="I confirm the equipment will be returned on time and in good condition." wrapText="true" styleClass="modal-checkbox"/>
                    <Label fx:id="lblErrorMsg" styleClass="form-message-error" wrapText="true" maxWidth="Infinity"/>

                    <Button fx:id="btnSubmitRequest" text="Submit Borrow Request" styleClass="btn-success" maxWidth="Infinity" prefHeight="44" onAction="#handleConfirmCommit"/>
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</VBox>

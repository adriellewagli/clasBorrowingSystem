<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.user.EquipmentCatalogController">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Equipment Catalog" styleClass="page-title"/>
            <Label text="Everything in the inventory, with its current status and fees. Browse only - use Borrow Equipment to request an item." styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="btnRefresh" text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Search by name, category, serial, or status..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbStatus" prefWidth="190" prefHeight="40"/>
    </HBox>

    <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS" minHeight="220">
        <TableView fx:id="tblCatalog" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="EQUIPMENT ITEM" prefWidth="220"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="160"/>
                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="140"/>
                <TableColumn fx:id="colBorrowFee" text="BORROWING FEE" prefWidth="140"/>
                <TableColumn fx:id="colLateFee" text="LATE FEE / DAY" prefWidth="140"/>
            </columns>
        </TableView>
        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
            <Label fx:id="lblRowCount" text="0 records" styleClass="footer-caption"/>
        </HBox>
    </VBox>
</VBox>
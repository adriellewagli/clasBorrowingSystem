<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="catalogViewContainer" spacing="18" stylesheets="@../../css/dashboard.css" styleClass="root-canvas"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.user.EquipmentCatalogController">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- Metric Cards -->
    <HBox spacing="18">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Total Equipment Units" styleClass="metric-title"/>
            <Label fx:id="lblTotalUnits" text="0" styleClass="metric-value-dark"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Available for Borrow" styleClass="metric-title"/>
            <Label fx:id="lblAvailableUnits" text="0" styleClass="metric-value-blue"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Checked Out / In Use" styleClass="metric-title"/>
            <Label fx:id="lblCheckedOutUnits" text="0" styleClass="metric-value-red"/>
        </VBox>
    </HBox>

    <!-- Filter & Search Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="txtSearch" promptText="Search equipment name, category, or serial number..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>

        <HBox spacing="6">
            <Button fx:id="btnFilterAll" text="All" styleClass="filter-chip-active" onAction="#filterAll"/>
            <Button fx:id="btnFilterAvailable" text="Available" styleClass="filter-chip" onAction="#filterAvailable"/>
            <Button fx:id="btnFilterMaintenance" text="In Maintenance" styleClass="filter-chip" onAction="#filterRepair"/>
        </HBox>

        <Button fx:id="btnRefreshData" text="🔄 Refresh Data" styleClass="btn-secondary" onAction="#handleManualRefresh"/>
    </HBox>

    <!-- Equipment Table Card -->
    <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblEquipment" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No equipment items found" styleClass="empty-state"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colName" text="EQUIPMENT NAME" prefWidth="220"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="160"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="140"/>
                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
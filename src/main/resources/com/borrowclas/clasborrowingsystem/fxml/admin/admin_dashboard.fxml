<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../../css/dashboard.css"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.admin.AdminDashboardController">

    <BorderPane fx:id="mainContentPane">
        <top>
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="logo-badge">
                        <Label text="CL" styleClass="logo-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label text="CLAS System Administration" styleClass="header-title"/>
                        <Label text="Inventory &amp; Returns Manager" styleClass="header-subtitle"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8">
                    <Label text="System Status:" styleClass="top-console-label"/>
                    <Label text="• Operational" styleClass="status-pill-green"/>
                </HBox>
            </HBox>
        </top>

        <left>
            <VBox styleClass="sidebar" prefWidth="230" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="user-avatar-circle">
                        <Label fx:id="lblUserAvatar" text="AD" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="3">
                        <Label fx:id="lblUserName" text="Admin User" styleClass="user-profile-name"/>
                        <Label fx:id="lblUserRole" text="ADMIN" styleClass="role-badge"/>
                    </VBox>
                </HBox>

                <Separator styleClass="sidebar-divider"/>

                <Button fx:id="btnNavReturns" text="Process Returns" styleClass="sidebar-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewReturns"/>
                <Button fx:id="btnNavRequests" text="Manage Requests" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewRequests"/>
                <Button fx:id="btnNavInventory" text="Manage Inventory" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewInventory"/>
                <Button fx:id="btnNavMaintenance" text="Maintenance Log" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewMaintenance"/>
                <Button fx:id="btnNavHistory" text="Audit History" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewHistory"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Log Out" styleClass="sidebar-btn-logout" maxWidth="Infinity" alignment="CENTER" onAction="#handleLogout"/>
            </VBox>
        </left>

        <center>
            <StackPane fx:id="dynamicContentArea">
                <VBox fx:id="returnsViewContainer" spacing="18">
                    <padding>
                        <Insets top="24" right="28" bottom="24" left="28"/>
                    </padding>

                    <HBox spacing="18">
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Currently Checked Out" styleClass="metric-title"/>
                            <Label fx:id="lblTotalCheckedOut" text="0" styleClass="metric-value-dark"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Pending Returns" styleClass="metric-title"/>
                            <Label fx:id="lblPendingReturns" text="0" styleClass="metric-value-blue"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Overdue Items" styleClass="metric-title"/>
                            <Label fx:id="lblOverdueItems" text="0" styleClass="metric-value-red"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <TextField fx:id="txtSearch" promptText="Search transaction ID, student name, or serial number..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh Data" styleClass="btn-secondary" onAction="#loadTransactionData"/>
                    </HBox>

                    <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="tblTransactions" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No transactions to show" styleClass="empty-state"/>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="colTransId" text="TRANS ID" prefWidth="90"/>
                                <TableColumn fx:id="colBorrower" text="BORROWER" prefWidth="150"/>
                                <TableColumn fx:id="colEquipment" text="EQUIPMENT" prefWidth="200"/>
                                <TableColumn fx:id="colDueDate" text="DUE DATE" prefWidth="120"/>
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
                                <TableColumn fx:id="colAction" text="ACTION" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

    <StackPane fx:id="modalOverlay" visible="false" styleClass="modal-backdrop" StackPane.alignment="CENTER">
        <VBox styleClass="modal-dialog" maxWidth="420" maxHeight="-Infinity" spacing="18" StackPane.alignment="CENTER">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Process Equipment Return" styleClass="modal-title"/>
                    <Label fx:id="lblModalEquipmentName" text="Asset Name" styleClass="modal-asset-name"/>
                </VBox>
                <Button text="✕" styleClass="modal-close-btn" onAction="#closeModal"/>
            </HBox>

            <Separator styleClass="sidebar-divider"/>

            <VBox spacing="8">
                <Label text="Condition upon return:" styleClass="modal-label"/>
                <ComboBox fx:id="comboCondition" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="lblLateFeeWarning" text="Item is overdue. Late fees apply." styleClass="modal-error-label" visible="false" managed="false" maxWidth="Infinity"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#closeModal"/>
                <Button text="Confirm Return" styleClass="btn-primary" onAction="#confirmReturn"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>

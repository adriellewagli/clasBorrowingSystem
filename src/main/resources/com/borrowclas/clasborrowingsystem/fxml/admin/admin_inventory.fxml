<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="16" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.AdminInventoryController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LEFT SIDE: INVENTORY TABLE -->
    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="txtSearch" promptText="Search inventory by name, category, or serial..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
        </HBox>

        <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colName" text="ITEM NAME" prefWidth="180"/>
                    <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="140"/>
                    <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="140"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- RIGHT SIDE: ADD NEW EQUIPMENT FORM -->
    <VBox spacing="14" styleClass="main-dashboard-card" prefWidth="320">
        <Label text="Add New Equipment" styleClass="modal-title"/>
        <Separator styleClass="sidebar-divider"/>

        <VBox spacing="6">
            <Label text="Item Name:" styleClass="modal-label"/>
            <TextField fx:id="txtName" promptText="e.g. Sony Mirrorless Camera" styleClass="clean-search-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Category:" styleClass="modal-label"/>
            <!-- CLEANED: No inline collection blocks -->
            <ComboBox fx:id="comboCategory" maxWidth="Infinity" promptText="Select category"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Serial Number:" styleClass="modal-label"/>
            <TextField fx:id="txtSerial" promptText="e.g. SN-SN-99102" styleClass="clean-search-field"/>
        </VBox>

        <Label fx:id="lblFormError" text="" styleClass="modal-error-label"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button text="Save to Database" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleSaveEquipment"/>
    </VBox>
</HBox>
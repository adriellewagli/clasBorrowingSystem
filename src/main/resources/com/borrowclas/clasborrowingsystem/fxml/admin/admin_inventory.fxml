<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.admin.AdminInventoryController"
      stylesheets="@/com/borrowclas/clasborrowingsystem/css/dashboard.css">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- LEFT: INVENTORY TABLE -->
    <VBox spacing="18" HBox.hgrow="ALWAYS">
        <VBox spacing="3">
            <Label text="Manage Inventory" styleClass="page-title"/>
            <Label text="Browse, search and add equipment in the catalog" styleClass="page-subtitle"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="txtSearch" promptText="Search inventory by name, category, serial, or status..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
        </HBox>

        <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colName" text="ITEM NAME" prefWidth="190"/>
                    <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="150"/>
                    <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
                <Label fx:id="lblRowCount" text="0 records" styleClass="footer-caption"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- RIGHT: ADD NEW EQUIPMENT -->
    <VBox spacing="16" styleClass="main-dashboard-card" prefWidth="340" minWidth="340" maxHeight="-Infinity" alignment="TOP_LEFT">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>

        <VBox spacing="3">
            <Label text="Add New Equipment" styleClass="modal-title"/>
            <Label text="New items are saved as Available" styleClass="page-subtitle"/>
        </VBox>
        <Separator styleClass="sidebar-divider"/>

        <VBox spacing="6">
            <Label text="Item Name" styleClass="modal-label"/>
            <TextField fx:id="txtName" promptText="e.g. Sony Mirrorless Camera" styleClass="clean-search-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Category" styleClass="modal-label"/>
            <ComboBox fx:id="comboCategory" maxWidth="Infinity" promptText="Select category" prefHeight="40"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Serial Number" styleClass="modal-label"/>
            <TextField fx:id="txtSerial" promptText="e.g. SN-99102" styleClass="clean-search-field"/>
        </VBox>

        <Label fx:id="lblFormError" text="" styleClass="form-message-error" wrapText="true" maxWidth="Infinity"/>

        <Button text="Save to Database" styleClass="btn-primary" maxWidth="Infinity" prefHeight="42" onAction="#handleSaveEquipment"/>
    </VBox>
</HBox>

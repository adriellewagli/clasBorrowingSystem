<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" styleClass="root-canvas" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.admin.MaintenanceLogController" stylesheets="@../../css/dashboard.css">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Maintenance Log" styleClass="page-title"/>
            <Label text="Track damaged or in-repair items and restore them to the catalog." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Refresh Log" onAction="#handleRefresh" styleClass="btn-secondary"/>
    </HBox>

    <!-- METRICS -->
    <HBox spacing="18">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Total Under Maintenance" styleClass="metric-title"/>
            <Label fx:id="lblMaintenanceCount" text="0" styleClass="metric-value-dark"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Repair Queue Status" styleClass="metric-title"/>
            <Label text="Active Inspection" styleClass="metric-value-blue"/>
        </VBox>
    </HBox>

    <!-- SEARCH -->
    <TextField fx:id="txtSearch" promptText="Search maintenance items by name, category, or serial..." styleClass="clean-search-field"/>

    <!-- TABLE CARD -->
    <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblMaintenance" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colName" text="EQUIPMENT ITEM" prefWidth="220"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="160"/>
                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="140"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblRowCount" text="0 records" styleClass="footer-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Tip: 'Mark as Fixed' returns the item to the catalog." styleClass="footer-caption"/>
        </HBox>
    </VBox>
</VBox>

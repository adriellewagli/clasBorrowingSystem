<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" stylesheets="@../../css/dashboard.css" styleClass="root-canvas"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.superadmin.PasswordRequestsController">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Password Reset Requests" styleClass="header-title"/>
            <Label text="Review and manage pending user password change tickets" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" promptText="Search username, name, or ticket ID..." styleClass="clean-search-field" prefWidth="320"/>
        <Button text="🔄 Refresh" styleClass="btn-secondary" onAction="#loadTickets"/>
    </HBox>

    <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblTickets" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No pending password requests" styleClass="empty-state"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colTicketId" text="TICKET ID" prefWidth="90"/>
                <TableColumn fx:id="colUsername" text="USERNAME" prefWidth="160"/>
                <TableColumn fx:id="colFullName" text="FULL NAME" prefWidth="200"/>
                <TableColumn fx:id="colRequestDate" text="REQUESTED ON" prefWidth="180"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
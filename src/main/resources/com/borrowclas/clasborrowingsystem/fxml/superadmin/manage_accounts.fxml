<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.superadmin.AccountManagementController">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- PAGE HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Account Management" styleClass="page-title"/>
            <Label text="Create, activate, deactivate and delete user, admin and super admin accounts" styleClass="page-subtitle"/>
        </VBox>
        <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
        <Button text="+ Create Account" styleClass="btn-primary" onAction="#handleCreateAccount"/>
    </HBox>

    <!-- SEARCH + ROLE FILTER -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Search by name, username, role or status..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbRoleFilter" prefWidth="170" prefHeight="40"/>
    </HBox>

    <!-- TABLE CARD -->
    <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblAccounts" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colFullName" text="FULL NAME" prefWidth="210"/>
                <TableColumn fx:id="colUsername" text="USERNAME" prefWidth="160"/>
                <TableColumn fx:id="colRole" text="ROLE" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="140"/>
                <TableColumn fx:id="colCredentials" text="LOGIN DETAILS" prefWidth="140"/>
                <TableColumn fx:id="colActions" text="ACTIONS" minWidth="250" prefWidth="250" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
            <Label fx:id="lblRowCount" text="0 records" styleClass="footer-caption"/>
        </HBox>
    </VBox>
</VBox>

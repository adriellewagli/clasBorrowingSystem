<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-container" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CreateAccountController">

    <!-- Top System Navigation Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-header">
            <padding>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" styleClass="logo-badge">
                    <children>
                        <Label styleClass="logo-text" text="CL" />
                    </children>
                </HBox>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="header-title" text="CLAS Equipment Borrowing Management System" />
                        <Label styleClass="header-subtitle" text="College of Liberal Arts &amp; Sciences" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- Center Create Account Card -->
    <center>
        <VBox alignment="CENTER" styleClass="main-canvas" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="cardContainer" maxWidth="440.0" minWidth="440.0" spacing="18.0" styleClass="login-card">
                    <padding>
                        <Insets bottom="32.0" left="36.0" right="36.0" top="32.0" />
                    </padding>
                    <children>
                        <!-- Card Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="card-title" text="Create Account" />
                                <Label styleClass="card-subtitle" text="Register a new staff system account (Requires Super Admin Approval)" />
                            </children>
                        </VBox>

                        <!-- Form Inputs -->
                        <VBox spacing="12.0">
                            <children>
                                <!-- Full Name Input -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="input-label" text="Full Name" />
                                        <TextField fx:id="txtFullName" promptText="e.g. Juan Cruz" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- Username Input -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="input-label" text="Username" />
                                        <TextField fx:id="txtUsername" promptText="Choose a unique username" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- Role Selection -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="input-label" text="Account Level / Role" />
                                        <ComboBox fx:id="cmbRole" maxWidth="1.7976931348623157E308" promptText="Select Role" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- Password Input -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="input-label" text="Password" />
                                        <PasswordField fx:id="txtPassword" promptText="Enter password" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- Confirm Password Input -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="input-label" text="Confirm Password" />
                                        <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter password" styleClass="clean-text-field" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Actions & Back Link -->
                        <VBox spacing="12.0">
                            <children>
                                <Button fx:id="btnRegister" maxWidth="1.7976931348623157E308" onAction="#handleRegister" styleClass="btn-lavender" text="Register Account" />

                                <HBox alignment="CENTER" styleClass="links-row">
                                    <children>
                                        <Hyperlink onAction="#handleBackToLogin" styleClass="card-link" text="Already have an account? Log in" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Status / Message Label -->
                        <Label fx:id="lblMessage" styleClass="error-message-text" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
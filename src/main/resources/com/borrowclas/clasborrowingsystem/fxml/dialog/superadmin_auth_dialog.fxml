<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardContainer" spacing="20.0" styleClass="login-card" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.dialog.SuperAdminAuthDialogController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <!-- Header -->
        <VBox spacing="4.0">
            <children>
                <Label styleClass="card-title" text="Super Admin Authorization" />
                <Label fx:id="lblActionDescription" styleClass="card-subtitle" text="Super Admin credentials are required to perform this action." wrapText="true" />
            </children>
        </VBox>

        <!-- Input Fields -->
        <VBox spacing="12.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="input-label" text="Super Admin Username" />
                        <TextField fx:id="txtAdminUsername" promptText="Enter super admin username" styleClass="clean-text-field" />
                    </children>
                </VBox>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="input-label" text="Super Admin Password" />
                        <PasswordField fx:id="txtAdminPassword" onAction="#handleAuthenticate" promptText="••••••••" styleClass="clean-text-field" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Message Status -->
        <Label fx:id="lblMessage" styleClass="error-message-text" wrapText="true" />

        <!-- Button Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#handleCancel" styleClass="card-link" text="Cancel" />
                <Button fx:id="btnConfirm" minWidth="150.0" onAction="#handleAuthenticate" styleClass="btn-lavender" text="Authorize Action">
                    <padding>
                        <Insets bottom="10.0" left="28.0" right="28.0" top="10.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
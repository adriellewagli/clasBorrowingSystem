<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" styleClass="main-canvas" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <ProgressIndicator prefHeight="48.0" prefWidth="48.0" styleClass="progress-indicator" />
        <VBox alignment="CENTER" spacing="4.0">
            <children>
                <Label styleClass="card-title" text="Loading..." />
                <Label styleClass="card-subtitle" text="Please wait while the page is preparing" />
            </children>
        </VBox>
    </children>
</VBox>
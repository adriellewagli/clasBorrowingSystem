<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Circle?>

<!-- Added stylesheets link so it inherits your global font -->
<StackPane fx:id="overlayRoot" style="-fx-background-color: rgba(255, 255, 255, 0.85);"
           stylesheets="@../../css/dashboard.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.dialog.LoadingOverlayController">

    <VBox alignment="CENTER" spacing="16">

        <!-- Modern Bouncing Dots -->
        <HBox alignment="CENTER" spacing="8">
            <Circle fx:id="dot1" radius="6" fill="#3b82f6"/>
            <Circle fx:id="dot2" radius="6" fill="#3b82f6"/>
            <Circle fx:id="dot3" radius="6" fill="#3b82f6"/>
        </HBox>

        <!-- Replaced inline fonts with your styleClass -->
        <Label fx:id="lblLoadingText" text="Loading..." styleClass="modal-label" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
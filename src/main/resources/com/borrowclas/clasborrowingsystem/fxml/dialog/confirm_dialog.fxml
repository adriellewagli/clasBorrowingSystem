<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18" prefWidth="440"
      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.dialog.ConfirmDialogController">

    <padding>
        <Insets top="32" right="40" bottom="32" left="40"/>
    </padding>

    <!-- Optional Question / Icon Indicator Badge -->
    <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50; -fx-max-width: 50; -fx-max-height: 50;">
        <Label text="?" style="-fx-text-fill: #d97706; -fx-font-size: 26px; -fx-font-weight: bold;"/>
    </StackPane>

    <!-- Text Content -->
    <VBox alignment="CENTER" spacing="8">
        <Label fx:id="lblTitle" text="Confirm Approval" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Label fx:id="lblMessage" text="Are you sure you want to approve this request?" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
    </VBox>

    <!-- Action Buttons -->
    <HBox alignment="CENTER" spacing="14">
        <VBox.margin>
            <Insets top="12"/>
        </VBox.margin>
        <Button text="Cancel" onAction="#handleCancel" prefWidth="130"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 10 16 10 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <!-- Orange/Amber Action Button -->
        <Button text="Confirm Approval" onAction="#handleConfirm" prefWidth="150"
                style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 10 16 10 16; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
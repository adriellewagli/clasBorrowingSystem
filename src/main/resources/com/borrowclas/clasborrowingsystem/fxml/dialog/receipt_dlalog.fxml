<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox alignment="CENTER" spacing="16"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.dialog.ReceiptDialogController">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Blue Printer/Document Icon Circle -->
    <StackPane style="-fx-background-color: #dbeafe; -fx-background-radius: 50; -fx-min-width: 60; -fx-min-height: 60; -fx-max-width: 60; -fx-max-height: 60;">
        <Label text="📄" style="-fx-font-size: 28px;"/>
    </StackPane>

    <!-- Text Content -->
    <VBox alignment="CENTER" spacing="6">
        <Label fx:id="lblTitle" text="Request Approved!" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Label fx:id="lblMessage" text="How would you like to print your receipt?" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
    </VBox>

    <!-- Action Buttons -->
    <HBox alignment="CENTER" spacing="12">
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
        <Button text="Do Not Print" onAction="#handleNone" prefWidth="120"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button text="Individual" onAction="#handleIndividual" prefWidth="120"
                style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button text="1 Combined" onAction="#handleCombined" prefWidth="120"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 13px; -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
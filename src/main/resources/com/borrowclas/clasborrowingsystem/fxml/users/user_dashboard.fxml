<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../../css/dashboard.css"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.user.UserDashboardController">

    <!-- MAIN DASHBOARD CONTENT -->
    <BorderPane fx:id="mainContentPane">
        <!-- TOP HEADER -->
        <top>
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="logo-badge">
                        <Label text="CL" styleClass="logo-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="CLAS Borrowing System" styleClass="header-title"/>
                        <Label text="Equipment Portal" styleClass="header-subtitle"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8">
                    <Label text="System Status:" styleClass="top-console-label"/>
                    <Label text="• Operational" styleClass="status-pill-green"/>
                </HBox>
            </HBox>
        </top>

        <!-- SIDEBAR -->
        <left>
            <VBox styleClass="sidebar" prefWidth="220" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="user-avatar-circle">
                        <Label fx:id="lblUserAvatar" text="US" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="lblUserName" text="User Name" styleClass="user-profile-name"/>
                        <Label fx:id="lblUserRole" text="STUDENT" styleClass="role-badge"/>
                    </VBox>
                </HBox>

                <Separator styleClass="sidebar-divider"/>

                <Button fx:id="btnNavCatalog" text="Equipment Catalog" styleClass="sidebar-btn-active" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewCatalog"/>
                <Button fx:id="btnNavMyBorrows" text="My Active Borrows" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewMyBorrows"/>
                <Button fx:id="btnNavRequestLog" text="Request History Log" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewRequestLog"/>
                <Button fx:id="btnNavSettings" text="Account Settings" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleViewSettings"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Log Out" styleClass="sidebar-btn-logout" maxWidth="Infinity" alignment="CENTER" onAction="#handleLogout"/>
            </VBox>
        </left>

        <!-- DYNAMIC CENTER CONTENT AREA -->
        <center>
            <StackPane fx:id="dynamicContentArea">
                <!-- DEFAULT CATALOG VIEW -->
                <VBox fx:id="catalogViewContainer" spacing="16">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- METRIC OVERVIEW CARDS -->
                    <HBox spacing="16">
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Catalog Units" styleClass="metric-title"/>
                            <Label fx:id="lblTotalUnits" text="0" styleClass="metric-value-dark"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Available to Borrow" styleClass="metric-title"/>
                            <Label fx:id="lblAvailableUnits" text="0" styleClass="metric-value-green"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <Label text="Currently Checked Out" styleClass="metric-title"/>
                            <Label fx:id="lblCheckedOutUnits" text="0" styleClass="metric-value-blue"/>
                        </VBox>
                    </HBox>

                    <!-- SEARCH & FILTER ROW -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <TextField fx:id="txtSearch" promptText="Search equipment name, serial, or category..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button text="All Gear" styleClass="filter-chip-active" onAction="#filterAll"/>
                            <Button text="Available Only" styleClass="filter-chip" onAction="#filterAvailable"/>
                            <Button text="In Maintenance" styleClass="filter-chip" onAction="#filterRepair"/>
                        </HBox>
                    </HBox>

                    <!-- MAIN TABLE CARD -->
                    <VBox styleClass="main-dashboard-card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="tblEquipment" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName" text="EQUIPMENT ITEM" prefWidth="280"/>
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="180"/>
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="150"/>
                                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="160"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
                            <Label text="Tip: Click on any 'AVAILABLE' item row to launch a borrowing request." styleClass="footer-caption"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

    <!-- BORROW REQUEST MODAL OVERLAY -->
    <StackPane fx:id="modalOverlay" visible="false" styleClass="modal-backdrop" StackPane.alignment="CENTER">
        <VBox styleClass="modal-dialog" maxWidth="460" spacing="16" StackPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Confirm Equipment Borrowing Request" styleClass="modal-title"/>
                    <Label fx:id="lblModalAssetName" text="Asset Name" styleClass="modal-asset-name"/>
                    <Label fx:id="lblModalAssetDept" text="Owner Division" styleClass="modal-asset-dept"/>
                </VBox>
                <Button text="✕" styleClass="modal-close-btn" onAction="#closeModal"/>
            </HBox>

            <Separator styleClass="sidebar-divider"/>

            <VBox spacing="8">
                <Label text="Select Planned Return Target Date:" styleClass="modal-label"/>
                <HBox spacing="8">
                    <Button text="3 Days" styleClass="filter-chip" onAction="#select3Days"/>
                    <Button text="7 Days" styleClass="filter-chip-active" onAction="#select7Days"/>
                    <Button text="Custom" styleClass="filter-chip" onAction="#selectCustomDate"/>
                </HBox>
                <DatePicker fx:id="dpReturnTarget" maxWidth="Infinity" styleClass="modal-datepicker"/>
            </VBox>

            <CheckBox fx:id="chkCompliance"
                      text="I agree to return the equipment on or before the due date and assume responsibility for physical care."
                      wrapText="true"
                      styleClass="modal-checkbox"/>

            <Label fx:id="lblModalError" styleClass="modal-error-label" wrapText="true"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#closeModal"/>
                <Button text="Confirm Request" styleClass="btn-primary" onAction="#confirmBorrowCommit"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
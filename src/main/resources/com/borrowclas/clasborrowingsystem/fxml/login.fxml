<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-container" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <!-- Top System Navigation Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-header">
            <padding>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" styleClass="logo-badge">
                    <children>
                        <Label styleClass="logo-text" text="CL" />
                    </children>
                </HBox>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="header-title" text="CLAS Equipment Borrowing Management System" />
                        <Label styleClass="header-subtitle" text="College of Liberal Arts &amp; Sciences" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- Center Login Card -->
    <center>
        <VBox alignment="CENTER" styleClass="main-canvas" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="cardContainer" maxWidth="420.0" minWidth="420.0" spacing="24.0" styleClass="login-card">
                    <padding>
                        <Insets bottom="32.0" left="36.0" right="36.0" top="36.0" />
                    </padding>
                    <children>
                        <!-- Card Header -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="card-title" text="CLAS Login Form" />
                                <Label styleClass="card-subtitle" text="Sign in to manage equipment inventory and requests" />
                            </children>
                        </VBox>

                        <!-- Form Inputs -->
                        <VBox spacing="16.0">
                            <children>
                                <!-- Username Input -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="input-label" text="Username" />
                                        <TextField fx:id="txtUsername" onAction="#focusPassword" promptText="e.g. j_smith" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- Password Input -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="input-label" text="Password" />
                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="••••••••" styleClass="clean-text-field, password-padding" />
                                                <TextField fx:id="txtPasswordShown" managed="false" onAction="#handleLogin" promptText="••••••••" styleClass="clean-text-field, password-padding" visible="false" />
                                                <Button fx:id="btnTogglePassword" focusTraversable="false" onAction="#togglePasswordVisibility" styleClass="eye-toggle-btn, eye-open" StackPane.alignment="CENTER_RIGHT">
                                                    <StackPane.margin>
                                                        <Insets right="10.0" />
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Actions & Links -->
                        <VBox spacing="16.0">
                            <children>
                                <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" onAction="#handleLogin" styleClass="btn-lavender" text="Login" />

                                <HBox alignment="CENTER" styleClass="links-row">
                                    <children>
                                        <Hyperlink onAction="#handleForgotPassword" styleClass="card-link" text="Forgot Password?" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Hyperlink onAction="#handleSignUp" styleClass="card-link-bold" text="Create Account" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Error Message Label -->
                        <Label fx:id="lblMessage" styleClass="error-message-text" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="root-container" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.auth.ForgotPasswordController">

    <!-- Top System Navigation Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-header">
            <padding>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" styleClass="logo-badge">
                    <children>
                        <Label styleClass="logo-text" text="CL" />
                    </children>
                </HBox>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="header-title" text="CLAS Equipment Borrowing Management System" />
                        <Label styleClass="header-subtitle" text="College of Liberal Arts &amp; Sciences" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- Center Reset Password Card -->
    <center>
        <VBox alignment="CENTER" styleClass="main-canvas" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="cardContainer" maxWidth="420.0" minWidth="420.0" spacing="20.0" styleClass="login-card">
                    <padding>
                        <Insets bottom="32.0" left="36.0" right="36.0" top="36.0" />
                    </padding>
                    <children>
                        <!-- Card Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="card-title" text="Reset Password" />
                                <Label styleClass="card-subtitle" text="Verify your username to set a new account password" />
                            </children>
                        </VBox>

                        <!-- Form Inputs -->
                        <VBox spacing="14.0">
                            <children>
                                <!-- Username Input -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="input-label" text="Username" />
                                        <TextField fx:id="txtUsername" onAction="#focusNewPassword" promptText="Enter your registered username" styleClass="clean-text-field" />
                                    </children>
                                </VBox>

                                <!-- New Password Field with Eye Toggle -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="input-label" text="New Password" />
                                        <StackPane styleClass="password-container">
                                            <children>
                                                <PasswordField fx:id="txtNewPassword" onAction="#focusConfirmPassword" promptText="Enter new password" styleClass="clean-text-field, password-padding" />
                                                <TextField fx:id="txtNewPasswordShown" managed="false" onAction="#focusConfirmPassword" promptText="Enter new password" styleClass="clean-text-field, password-padding" visible="false" />
                                                <Button fx:id="btnToggleNewPassword" focusTraversable="false" onAction="#toggleNewPasswordVisibility" styleClass="eye-toggle-btn" StackPane.alignment="CENTER_RIGHT">
                                                    <graphic>
                                                        <SVGPath fx:id="svgEyeIconNew" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" styleClass="eye-icon" />
                                                    </graphic>
                                                    <StackPane.margin>
                                                        <Insets right="6.0" />
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- Confirm New Password Field with Eye Toggle -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="input-label" text="Confirm New Password" />
                                        <StackPane styleClass="password-container">
                                            <children>
                                                <PasswordField fx:id="txtConfirmPassword" onAction="#handleResetPassword" promptText="Re-enter new password" styleClass="clean-text-field, password-padding" />
                                                <TextField fx:id="txtConfirmPasswordShown" managed="false" onAction="#handleResetPassword" promptText="Re-enter new password" styleClass="clean-text-field, password-padding" visible="false" />
                                                <Button fx:id="btnToggleConfirmPassword" focusTraversable="false" onAction="#toggleConfirmPasswordVisibility" styleClass="eye-toggle-btn" StackPane.alignment="CENTER_RIGHT">
                                                    <graphic>
                                                        <SVGPath fx:id="svgEyeIconConfirm" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" styleClass="eye-icon" />
                                                    </graphic>
                                                    <StackPane.margin>
                                                        <Insets right="6.0" />
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Actions & Back Link -->
                        <VBox spacing="14.0">
                            <children>
                                <Button fx:id="btnResetPassword" maxWidth="1.7976931348623157E308" onAction="#handleResetPassword" styleClass="btn-primary" text="Update Password" />

                                <HBox alignment="CENTER">
                                    <children>
                                        <Hyperlink onAction="#handleBackToLogin" styleClass="card-link" text="← Back to Login" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Status / Message Label -->
                        <Label fx:id="lblMessage" styleClass="error-message-text" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
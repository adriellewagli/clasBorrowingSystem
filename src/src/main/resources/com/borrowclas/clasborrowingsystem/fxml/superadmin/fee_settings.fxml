<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.superadmin.FeeSettingsController">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Fees &amp; Penalties" styleClass="page-title"/>
            <Label text="Set the borrowing fee and the late fee per day for each item. Changes apply to requests approved from now on." styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="btnRefresh" text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Search by item, category, or serial..." styleClass="clean-search-field" HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox fx:id="tableCard" styleClass="main-dashboard-card" VBox.vgrow="ALWAYS" minHeight="220">
        <TableView fx:id="tblFees" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="EQUIPMENT ITEM" prefWidth="230"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="160"/>
                <TableColumn fx:id="colSerial" text="SERIAL NUMBER" prefWidth="150"/>
                <TableColumn fx:id="colBorrowFee" text="BORROWING FEE" prefWidth="150"/>
                <TableColumn fx:id="colLateFee" text="LATE FEE" prefWidth="150"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="140" sortable="false" resizable="false"/>
            </columns>
        </TableView>
        <HBox styleClass="table-footer-bar" alignment="CENTER_LEFT">
            <Label fx:id="lblRowCount" text="0 records" styleClass="footer-caption"/>
        </HBox>
    </VBox>
</VBox>
